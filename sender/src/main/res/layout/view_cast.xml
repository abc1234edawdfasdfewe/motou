<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 连接卡片 -->
        <LinearLayout style="@style/CardBox">

            <TextView
                style="@style/SectionTitle"
                android:text="连接设备" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/ipEdit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:hint="设备 IP（如 192.168.31.68）"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/scanBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_ghost"
                    android:text="扫码"
                    android:textColor="#111111" />

                <Button
                    android:id="@+id/connectBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_primary"
                    android:text="连接"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="未连接"
                android:textColor="#888888"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/deviceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="设备（点按连接，长按删除已存）"
                android:textColor="#888888"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/deviceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 文字投送卡片 -->
        <LinearLayout
            style="@style/CardBox"
            android:layout_marginTop="14dp">

            <TextView
                style="@style/SectionTitle"
                android:text="文字 / 网址" />

            <EditText
                android:id="@+id/inputEdit"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_bg"
                android:gravity="top"
                android:hint="输入文字、粘贴内容，或填入网址（http 开头自动抓取正文）"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/sendTextBtn"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:text="投送文字 / 网址"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/pasteBtn"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_ghost"
                    android:text="粘贴剪切板"
                    android:textColor="#111111" />
            </LinearLayout>
        </LinearLayout>

        <!-- 文件 / 扫描 / 实时 卡片 -->
        <LinearLayout
            style="@style/CardBox"
            android:layout_marginTop="14dp">

            <TextView
                style="@style/SectionTitle"
                android:text="文件与实时" />

            <Button
                android:id="@+id/pickBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_primary"
                android:text="添加内容（拍照 / 选图 / 选文件）"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/liveBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_ghost"
                android:text="录屏实时投送（手机屏幕 → 墨水屏）"
                android:textColor="#111111" />

            <Button
                android:id="@+id/a11yBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_ghost"
                android:text="反向控制：未开启（点我去开启）"
                android:textColor="#111111" />
        </LinearLayout>

        <!-- PDF / 漫画翻页控制 -->
        <LinearLayout
            android:id="@+id/pdfBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <Button
                android:id="@+id/pdfPrev"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:text="上一页"
                android:textColor="#111111" />

            <TextView
                android:id="@+id/pdfInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:textColor="#000000"
                android:textSize="14sp" />

            <Button
                android:id="@+id/pdfNext"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:text="下一页"
                android:textColor="#111111" />
        </LinearLayout>

        <!-- 历史 -->
        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="历史（点按重投）"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
