<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/topbar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/settingsBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="返回"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- OCR 配置卡片 -->
            <LinearLayout style="@style/CardBox">

                <TextView
                    style="@style/SectionTitle"
                    android:text="OCR 文字识别（PaddleOCR-VL）" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Token"
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/ocrToken"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/input_bg"
                    android:hint="AI Studio Token"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="模型"
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/ocrModel"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/input_bg"
                    android:hint="PaddleOCR-VL-1.6"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/ocrSave"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_primary"
                    android:text="保存 OCR 配置"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- 大模型列表标题 -->
            <TextView
                style="@style/SectionTitle"
                android:layout_marginTop="20dp"
                android:text="AI 大模型（OpenAI 兼容接口）" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="填入各模型的接口地址与 API Key；「检测模型」自动拉取可用模型，「测试」验证连通性。"
                android:textColor="#888888"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/llmContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- 锁屏续聊保活 -->
            <LinearLayout
                style="@style/CardBox"
                android:layout_marginTop="20dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="墨水屏续聊保活" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="锁屏后继续响应墨水屏追问，需允许「忽略电池优化」，否则系统会冻结应用导致追问无回复。"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/batteryBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_ghost"
                    android:text="检查保活权限"
                    android:textColor="#111111" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
