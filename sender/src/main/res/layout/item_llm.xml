<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/CardBox"
    android:layout_marginTop="12dp">

    <TextView
        android:id="@+id/llmName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="模型名"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="接口地址（baseUrl）"
        android:textColor="#666666"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/llmBase"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/input_bg"
        android:hint="https://api.example.com/v1"
        android:inputType="textUri"
        android:paddingHorizontal="12dp"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="API Key"
        android:textColor="#666666"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/llmKey"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/input_bg"
        android:hint="sk-..."
        android:inputType="textPassword"
        android:paddingHorizontal="12dp"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="模型（model）"
        android:textColor="#666666"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/llmModel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/input_bg"
        android:hint="deepseek-chat"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/llmModels"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/btn_ghost"
            android:text="检测模型"
            android:textColor="#111111"
            android:textSize="13sp" />

        <Button
            android:id="@+id/llmTest"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_ghost"
            android:text="测试连通"
            android:textColor="#111111"
            android:textSize="13sp" />

        <Button
            android:id="@+id/llmSave"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:text="保存"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/llmResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#888888"
        android:textSize="12sp" />
</LinearLayout>
