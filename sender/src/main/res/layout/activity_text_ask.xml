<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F8"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/topbar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/askClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="关闭"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="问 AI（选中文字）"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 选中文字卡片 -->
            <LinearLayout style="@style/CardBox">
                <TextView
                    style="@style/SectionTitle"
                    android:text="选中文字" />
                <TextView
                    android:id="@+id/askSelected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/input_bg"
                    android:maxLines="10"
                    android:padding="12dp"
                    android:textColor="#333333"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 提示词 -->
            <LinearLayout
                style="@style/CardBox"
                android:layout_marginTop="14dp">
                <TextView
                    style="@style/SectionTitle"
                    android:text="提示词" />
                <EditText
                    android:id="@+id/askPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/input_bg"
                    android:gravity="top"
                    android:hint="例如：总结这段文字 / 解释其中的专业术语 / 翻译成英文"
                    android:minLines="3"
                    android:padding="12dp"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/askStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#888888"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/askSend"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="12dp"
        android:background="@drawable/btn_primary"
        android:text="发送给 AI"
        android:textColor="#FFFFFF" />
</LinearLayout>
