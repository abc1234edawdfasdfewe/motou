<?xml version="1.0" encoding="utf-8"?>
<!-- 位图操作条：位图/漫画模式中央点按唤起。翻页方向 / 对比度 / 全刷 / 保存 / 关闭 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelBitmap"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <View
        android:id="@+id/bitmapPanelScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_card"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 翻页方向（日漫从右往左读时点按区互换） -->
        <Button
            android:id="@+id/bitmapFlipDir"
            android:layout_width="360dp"
            android:layout_height="56dp"
            android:background="@drawable/btn_border"
            android:text="翻页方向：左旧右新（默认）"
            android:textColor="#000000"
            android:textSize="18sp" />

        <!-- 水平翻转（镜像扫描件/反向出图用） -->
        <Button
            android:id="@+id/bitmapMirror"
            android:layout_width="360dp"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_border"
            android:text="水平翻转：关"
            android:textColor="#000000"
            android:textSize="18sp" />

        <!-- 旋转（每点一次转 90°，横屏拍摄/扫描件转正用） -->
        <Button
            android:id="@+id/bitmapRotate"
            android:layout_width="360dp"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_border"
            android:text="旋转：0°（点按转 90°）"
            android:textColor="#000000"
            android:textSize="18sp" />

        <!-- 对比度 -->
        <LinearLayout
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/bitmapContrastDown"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/btn_border"
                android:text="对比度 −"
                android:textColor="#000000"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/bitmapContrastVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:text="0"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/bitmapContrastUp"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/btn_border"
                android:text="对比度 ＋"
                android:textColor="#000000"
                android:textSize="18sp" />
        </LinearLayout>

        <Button
            android:id="@+id/bitmapFullRefresh"
            android:layout_width="360dp"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_border"
            android:text="全刷一次（清残影）"
            android:textColor="#000000"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/bitmapSave"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/btn_border"
                android:text="保存"
                android:textColor="#000000"
                android:textSize="18sp" />

            <Button
                android:id="@+id/bitmapPanelClose"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:background="@drawable/btn_border"
                android:text="关闭"
                android:textColor="#000000"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
