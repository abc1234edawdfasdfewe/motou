<?xml version="1.0" encoding="utf-8"?>
<!-- 阅读格式面板（M4）：中央点按唤起。墨水屏规范：白底黑字、粗黑边框、大按钮。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelFormat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- 遮罩：点击关闭（全透明，仅拦截触摸） -->
    <View
        android:id="@+id/panelScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_card"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/panelPageInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="#000000"
            android:textSize="16sp" />

        <!-- 字号 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="字号"
                android:textColor="#000000"
                android:textSize="20sp" />

            <Button
                android:id="@+id/fontMinus"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_border"
                android:text="A−"
                android:textColor="#000000"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/fontValue"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="20sp" />

            <Button
                android:id="@+id/fontPlus"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_border"
                android:text="A＋"
                android:textColor="#000000"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- 行距 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="行距"
                android:textColor="#000000"
                android:textSize="20sp" />

            <Button
                android:id="@+id/lineMinus"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_border"
                android:text="−"
                android:textColor="#000000"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/lineValue"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="20sp" />

            <Button
                android:id="@+id/linePlus"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_border"
                android:text="＋"
                android:textColor="#000000"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- 边距 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="边距"
                android:textColor="#000000"
                android:textSize="20sp" />

            <Button
                android:id="@+id/padMinus"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_border"
                android:text="−"
                android:textColor="#000000"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/padValue"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="20sp" />

            <Button
                android:id="@+id/padPlus"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_border"
                android:text="＋"
                android:textColor="#000000"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- 字体 + 保存 + 关闭 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/fontFamily"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/btn_border"
                android:text="字体：黑体"
                android:textColor="#000000"
                android:textSize="20sp" />

            <Button
                android:id="@+id/panelSave"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/btn_border"
                android:text="保存"
                android:textColor="#000000"
                android:textSize="20sp" />

            <Button
                android:id="@+id/panelClose"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/btn_border"
                android:text="关闭"
                android:textColor="#000000"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
